/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# El Service Worker, la pàgina i el manifest sempre es revaliden perquè les versions noves arribin de seguida
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Els fitxers de /assets porten un hash al nom (cada build en canvia el nom): es poden guardar per sempre
/assets/*
  Cache-Control: public, max-age=31536000, immutable
