# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# El codi de l'app, el JSON i el YAML van amb 2 espais (HTML i SQL es queden amb 4)
[*.{ts,tsx,css,json,jsonc,yml,yaml}]
indent_size = 2

# Generat per "make db-types": no s'edita a mà.
[src/supabase/database.types.ts]
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
